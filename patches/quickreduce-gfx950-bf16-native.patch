 template<int world_size>
 struct TwoshotQ6LineCodec {
@@ -860,8 +997,48 @@ struct TwoshotQ8LineCodec {
 };
 
 
+__device_inline__
+static half bf16_to_fp16(uint16_t x) {
+    uint32_t bits = static_cast<uint32_t>(x) << 16;
+    float f = __builtin_bit_cast(float, bits);
+    return __float2half(f);
+}
+
+__device_inline__
+static uint16_t fp16_to_bf16(half x) {
+    float f = __half2float(x);
+    uint32_t bits = __builtin_bit_cast(uint32_t, f);
+    uint32_t lsb = (bits >> 16) & 1U;
+    bits += 0x7FFFU + lsb;
+    return static_cast<uint16_t>(bits >> 16);
+}
+
+__device_inline__
+static int32x4_t bf16x8_to_fp16x8(int32x4_t raw) {
+    int32x4_t out;
+    uint16_t const* src = reinterpret_cast<uint16_t const*>(&raw);
+    half* dst = reinterpret_cast<half*>(&out);
+    #pragma unroll
+    for (int i = 0; i < 8; i++) {
+        dst[i] = bf16_to_fp16(src[i]);
+    }
+    return out;
+}
+
+__device_inline__
+static int32x4_t fp16x8_to_bf16x8(int32x4_t raw) {
+    int32x4_t out;
+    half const* src = reinterpret_cast<half const*>(&raw);
+    uint16_t* dst = reinterpret_cast<uint16_t*>(&out);
+    #pragma unroll
+    for (int i = 0; i < 8; i++) {
+        dst[i] = fp16_to_bf16(src[i]);
+    }
+    return out;
+}
